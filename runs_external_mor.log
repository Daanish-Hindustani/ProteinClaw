[tool_use] Bash({'command': "python3 << 'EOF'\nimport json, glob\nfiles = sorted(glob.glob('/home/ubuntu/.claude/projects/-home-ubuntu-ProteinClaw-runs-dd582b0b2d8e/*/tool-results/mcp-proteinclaw_tools-structure_esmfold-*.txt'))\nprint('files:', len(files))\nall_preds = []\nfor f in files:\n    txt = open(f).read()\n    obj = json.loads(txt)\n    preds = obj.get('predictions', [])\n    for p in preds:\n        all_preds.append({'sequence': p['sequence'], 'confidence': p['confidence'], 'pdb_path': p['pdb_path'], 'num_residues': p['num_residues']})\nprint('total preds:', len(all_preds))\n# distribution\nconfs = sorted([p['confidence'] for p in all_preds], reverse=True)\nprint('min/max/median:', min(confs), max(confs), confs[len(confs)//2])\nprint('>=70:', sum(1 for c in confs if c>=70))\nprint('>=80:', sum(1 for c in confs if c>=80))\nprint('>=85:', sum(1 for c in confs if c>=85))\n# Map sequence -> library entry\nwith open('/home/ubuntu/.proteinclaw/gpu-workspace/dd582b0b2d8e/nanobody_library_1/library.json') as fh:\n    lib = json.load(fh)\nby_seq = {d['sequence']: d for d in lib['designs']}\n# Merge\nfor p in all_preds:\n    d = by_seq.get(p['sequence'])\n    if d:\n        p['id'] = d['id']\n        p['cdr1'] = d['cdr1']\n        p['cdr2'] = d['cdr2']\n        p['cdr3'] = d['cdr3']\n        p['cdr3_seq'] = d['cdr3_seq']\n        p['header'] = d['header']\n# Keep survivors with conf >= 80 (stricter than 70 since AF2 is bottleneck — we can only afford ~20-40 AF2 runs)\nsurv = [p for p in all_preds if p['confidence'] >= 80]\nsurv.sort(key=lambda x: -x['confidence'])\nprint('survivors @80:', len(surv))\n# Save\nwith open('/home/ubuntu/.proteinclaw/gpu-workspace/dd582b0b2d8e/esm_survivors.json','w') as fh:\n    json.dump(surv, fh)\nprint('Top 5:')\nfor s in surv[:5]:\n    print(' ', s['id'], s['confidence'], s['header'])\nEOF\n", 'description': 'Parse ESMFold results'})
