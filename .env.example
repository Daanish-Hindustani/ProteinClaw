# ProteinClaw env vars — copy to .env and tailor.
# Source of truth: src/proteinclaw/tools/factory.py + scripts/lambda_labs_setup.sh

# ─── Backend selection ───────────────────────────────────────────────────
# Global default applied when no per-tool override is set.
# auto → real backends where feasible; mock → never touch network or GPU.
PROTEINCLAW_BACKEND=auto

# Per-tool overrides take precedence over PROTEINCLAW_BACKEND.
# Uncomment and set when you want one tool to differ from the global mode.
# PROTEINCLAW_RCSB_BACKEND=auto           # auto | mock | rest
# PROTEINCLAW_FOLDSEEK_BACKEND=auto       # auto | mock | rest
# PROTEINCLAW_ALPHAFOLD_BACKEND=auto      # auto | mock | esm_atlas | colabfold
# PROTEINCLAW_RFDIFFUSION_BACKEND=auto    # auto | mock | local
# PROTEINCLAW_PROTEIN_MPNN_BACKEND=auto   # auto | mock | local

# ─── Install paths (required when a real local backend is selected) ──────
# Set after you've cloned the upstream repo for each tool.
# RFDIFFUSION_PATH=/opt/RFdiffusion3
# PROTEINMPNN_PATH=/opt/ProteinMPNN
# COLABFOLD_BIN=/opt/conda/envs/proteinclaw-colabfold/bin/colabfold_batch

# ─── Conda Python interpreters (subprocess targeting) ────────────────────
# The factory passes these to the local backends so subprocesses run inside
# the right conda env, not ProteinClaw's .venv.
# PROTEINCLAW_RFDIFFUSION_PYTHON=$HOME/proteinclaw-tools/miniforge3/envs/proteinclaw-rfdiffusion3/bin/python
# PROTEINCLAW_PROTEIN_MPNN_PYTHON=$HOME/proteinclaw-tools/miniforge3/envs/proteinclaw-protein-mpnn/bin/python

# ─── Setup-script knobs ──────────────────────────────────────────────────
# Pinned versions for reproducibility — bump deliberately.
# MINIFORGE_VERSION=25.3.0-3
# UV_VERSION=0.5.13
# INSTALL_PREFIX=$HOME/proteinclaw-tools
