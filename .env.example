# Protein Design Agent — Environment Configuration
# Copy this file to .env and fill in your API keys.
# Forked from Hermes Agent; messaging/voice/vision sections removed.

# =============================================================================
# LLM PROVIDER (OpenRouter)
# =============================================================================
# OpenRouter provides access to many models through one API.
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Default model is configured in ~/.hermes/config.yaml (model.default).
# Use 'hermes model' or 'hermes setup' to change it.

# =============================================================================
# LLM PROVIDER (Google AI Studio / Gemini)
# =============================================================================
# Native Gemini API via Google's OpenAI-compatible endpoint.
# Get your key at: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# =============================================================================
# LLM PROVIDER (Anthropic) — direct, optional
# =============================================================================
# ANTHROPIC_API_KEY=

# =============================================================================
# LLM PROVIDER (OpenAI) — direct, optional
# =============================================================================
# OPENAI_API_KEY=

# =============================================================================
# LLM PROVIDER (Hugging Face Inference Providers)
# =============================================================================
# HF_TOKEN=

# =============================================================================
# WEB TOOL API KEYS
# =============================================================================
# Exa — AI-native web search and contents (https://exa.ai)
# EXA_API_KEY=

# Parallel — AI-native web search and extract (https://parallel.ai)
# PARALLEL_API_KEY=

# Firecrawl — web search, extract, crawl (https://firecrawl.dev/)
# FIRECRAWL_API_KEY=

# =============================================================================
# PERSISTENT MEMORY (Honcho — optional)
# =============================================================================
# Honcho builds a persistent understanding of the user across sessions.
# Get at: https://app.honcho.dev
# Also requires ~/.honcho/config.json with enabled=true.
# HONCHO_API_KEY=

# =============================================================================
# TERMINAL TOOL CONFIGURATION
# =============================================================================
# Backend type: "local", "singularity", "docker", "modal", or "ssh"
# Configured in ~/.hermes/config.yaml (terminal.backend).
# TERMINAL_ENV=local
# HERMES_DOCKER_BINARY=/usr/local/bin/podman
# TERMINAL_DOCKER_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
# TERMINAL_SINGULARITY_IMAGE=docker://nikolaik/python-nodejs:python3.11-nodejs20
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# Working directory for terminal commands
# TERMINAL_CWD=.

# Default command timeout in seconds
TERMINAL_TIMEOUT=60

# Cleanup inactive environments after this many seconds
TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# SSH REMOTE EXECUTION (TERMINAL_ENV=ssh)
# =============================================================================
# TERMINAL_SSH_HOST=192.168.1.100
# TERMINAL_SSH_USER=agent
# TERMINAL_SSH_PORT=22
# TERMINAL_SSH_KEY=~/.ssh/id_rsa

# =============================================================================
# SUDO SUPPORT (all terminal backends)
# =============================================================================
# WARNING: Password stored in plaintext. Only use on trusted machines.
# SUDO_PASSWORD=

# =============================================================================
# MODAL CLOUD BACKEND (TERMINAL_ENV=modal)
# =============================================================================
# Modal uses CLI auth (`modal setup`); no env vars needed.

# =============================================================================
# BROWSER TOOL (Browserbase)
# =============================================================================
# Cloud browser execution for web research / PDB scraping.
# Get at: https://browserbase.com/
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
BROWSERBASE_PROXIES=true
BROWSERBASE_ADVANCED_STEALTH=false
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120

# =============================================================================
# DEBUG OPTIONS
# =============================================================================
WEB_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false

# =============================================================================
# CONTEXT COMPRESSION
# =============================================================================
# Configured in ~/.hermes/config.yaml under `compression:`.
# CONTEXT_COMPRESSION_ENABLED=true
# CONTEXT_COMPRESSION_THRESHOLD=0.85

# =============================================================================
# RL TRAINING (Tinker + Atropos) — optional
# =============================================================================
# TINKER_API_KEY=
# WANDB_API_KEY=
# RL_API_URL=http://localhost:8080

# =============================================================================
# SKILLS HUB (GitHub)
# =============================================================================
# GITHUB_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_INSTALLATION_ID=

# =============================================================================
# PROTEIN-DESIGN PLUGIN
# =============================================================================
# NCBI API key (optional, raises PubMed rate limits)
# NCBI_API_KEY=

# UniProt does not require a key.
# RCSB does not require a key.

# Inference SH (or whatever runtime hosts your RFdiffusion/ProteinMPNN/ESMFold)
# INFERENCE_SH_API_KEY=
# INFERENCE_SH_BASE_URL=

# Rosetta binary path (if using local rosetta-interface-analyzer skill)
# ROSETTA_BIN=/usr/local/rosetta/bin
